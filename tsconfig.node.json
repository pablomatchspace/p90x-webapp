{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // DOM is needed for browser-side code in Playwright specs (page.addInitScript
    // / evaluate callbacks run in the page context, e.g. seeding localStorage).
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    // worker/index.js is deliberately plain JS (paste-able into the Cloudflare
    // dashboard editor); checkJs keeps its JSDoc types honest all the same.
    "allowJs": true,
    "checkJs": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e", "worker"]
}
